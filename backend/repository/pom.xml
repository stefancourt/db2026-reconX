<?xml version="1.0" encoding="UTF-8"?>
<!--
 TICKET-ADV048 — repository: Spring Data JPA interfaces over the domain entities.

 Repositories, JPQL queries, Specifications. No business logic — that is what
 `service` is for. Depends on `domain` only, so it cannot reach up into services
 or controllers.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dbtraining</groupId>
        <artifactId>reconx</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>reconx-repository</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.dbtraining</groupId>
            <artifactId>reconx-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
         ADV055 — the repository smoke test runs @DataJpaTest against an in-memory
         H2. Test scope only: the runtime drivers belong to `api`.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
         Instrument.metadata is mapped with hypersistence's JsonBinaryType, which
         instantiates a Jackson ObjectMapper while Hibernate builds the metamodel.
         `api` picks Jackson up through spring-boot-starter-web; this module has no
         such transitive path, so without it the EntityManagerFactory fails with
         NoClassDefFoundError: com/fasterxml/jackson/databind/ObjectMapper.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

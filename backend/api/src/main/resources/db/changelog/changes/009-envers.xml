<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV052 — Hibernate Envers audit tables

 WHAT:    The revision registry (revinfo + revinfo_seq) and the audit table for
          trades (trades_aud).
 HOW:     Envers derives these names by convention: the revision entity maps to
          `revinfo`, and every @Audited entity gets `<table>_aud`. Column names
          `rev` and `revtype` are Envers defaults.
 WHY:     @Audited on the Trade entity registers those tables in the Hibernate
          metadata. With `ddl-auto: validate` the context refuses to start until
          they exist — "Schema-validation: missing table [revinfo]".
 OBSERVE: Update a trade, then `SELECT * FROM trades_aud` shows one row per
          revision with revtype 0 = INSERT, 1 = UPDATE, 2 = DELETE.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="009-create-revinfo" author="trainer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="revinfo"/>
            </not>
        </preConditions>
        <createTable tableName="revinfo">
            <column name="rev" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="revtstmp" type="BIGINT"/>
        </createTable>
        <rollback>
            <dropTable tableName="revinfo"/>
        </rollback>
    </changeSet>

    <!-- Envers asks Hibernate for the next revision number; AUTO resolves to a sequence. -->
    <changeSet id="009-create-revinfo-seq" author="trainer">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="revinfo_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="revinfo_seq" startValue="1" incrementBy="50"/>
        <rollback>
            <dropSequence sequenceName="revinfo_seq"/>
        </rollback>
    </changeSet>

    <changeSet id="009-create-trades-aud" author="trainer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="trades_aud"/>
            </not>
        </preConditions>
        <createTable tableName="trades_aud">
            <column name="rev" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="revtype" type="SMALLINT"/>
            <column name="trade_ref" type="VARCHAR(30)"/>
            <column name="instrument_id" type="BIGINT"/>
            <column name="counterparty_id" type="BIGINT"/>
            <column name="asset_class" type="VARCHAR(20)"/>
            <column name="side" type="VARCHAR(4)"/>
            <column name="quantity" type="NUMERIC(18,4)"/>
            <column name="price" type="NUMERIC(18,4)"/>
            <column name="trade_date" type="DATE"/>
            <column name="status" type="VARCHAR(20)"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="modified_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="trades_aud" baseColumnNames="rev"
                                 constraintName="fk_trades_aud_revinfo"
                                 referencedTableName="revinfo" referencedColumnNames="rev"/>
        <rollback>
            <dropTable tableName="trades_aud"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

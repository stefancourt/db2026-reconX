<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  ADV157 — Pragmatic Checkstyle config for ReconX backend.
  Based on Google checks with noisy rules disabled.
  Rules turned off are documented with the reason.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- No tab characters in source files -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Line length — 120 chars (Google default is 100, too short for Spring verbosity) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <!-- Suppress for long import statements and annotations -->
        <property name="ignorePattern" value="^(import|package|\s*\*|\s*//.*|.*@.*).*$"/>
    </module>

    <module name="TreeWalker">

        <!-- ── Imports ──────────────────────────────────────────────── -->
        <!-- No wildcard imports (import java.util.*) -->
        <module name="AvoidStarImport"/>
        <!-- No unused imports -->
        <module name="UnusedImports"/>
        <!-- No duplicate imports -->
        <module name="RedundantImport"/>

        <!-- ── Naming conventions ────────────────────────────────────── -->
        <module name="TypeName"/>           <!-- Classes: UpperCamelCase -->
        <module name="MethodName"/>         <!-- Methods: lowerCamelCase -->
        <module name="LocalVariableName"/>  <!-- Locals: lowerCamelCase -->
        <module name="ParameterName"/>      <!-- Params: lowerCamelCase -->
        <module name="ConstantName"/>       <!-- Constants: UPPER_SNAKE_CASE -->

        <!-- ── Code quality ─────────────────────────────────────────── -->
        <!-- No empty catch blocks (swallowing exceptions silently) -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore"/>
        </module>
        <!-- No empty blocks other than catch -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
            <property name="tokens" value="LITERAL_WHILE,LITERAL_TRY,LITERAL_FINALLY,LITERAL_DO,LITERAL_IF,LITERAL_ELSE,LITERAL_FOR,INSTANCE_INIT,STATIC_INIT,LITERAL_SWITCH,LITERAL_SYNCHRONIZED"/>
        </module>
        <!-- Braces required for all control flow blocks -->
        <module name="NeedBraces"/>
        <!-- No trailing whitespace -->
        <module name="Regexp">
            <property name="format" value="[ \t]+$"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Trailing whitespace"/>
        </module>

        <!-- ── Disabled / too noisy for this project ────────────────── -->
        <!--
          JavadocMethod    — disabled: project uses self-documenting ticket comments
                             instead of per-method Javadoc. Enforcing it would add
                             hundreds of empty Javadoc stubs.
          MagicNumber      — disabled: test data (prices, quantities) and domain
                             constants (e.g. 0.5 sleep, 500 cache size) are readable
                             in context. Extracting all to named constants adds noise.
          VisibilityModifier — disabled: Lombok @Data/@Builder generates public fields
                             internally; flagging them is a false positive.
          DesignForExtension — disabled: Spring @Service classes are intentionally
                             non-final with overridable methods for proxy support.
        -->

    </module>
</module>

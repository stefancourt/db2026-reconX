<?xml version="1.0" encoding="UTF-8"?>
<!--
 TICKET-ADV048 — service: business logic, DTOs, Kafka messaging, metrics.

 Packages:
   service/       — reconciliation engine, analytics, trade services.
   dto/           — request/response records plus the MapStruct entity mapper.
   kafka/         — producers and @KafkaListener consumers.
   observability/ — Micrometer meters and the database health indicator.

 Depends on `repository` (and transitively `domain`) plus `common` for the
 exception types. Knows nothing about HTTP — controllers live in `api`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dbtraining</groupId>
        <artifactId>reconx</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>reconx-service</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.dbtraining</groupId>
            <artifactId>reconx-repository</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dbtraining</groupId>
            <artifactId>reconx-common</artifactId>
        </dependency>

        <!-- ADV128-ADV136 — producers and consumers. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- ADV083-ADV097 — TradeMetrics and DatabaseHealthIndicator. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- ADV081-ADV082 — @Cacheable on InstrumentService. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- ADV054 — TradeMapper; the processor comes from the parent's compiler config. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ADV143/ADV144 — KafkaPipelineIT and DlqRoutingIT drive a real broker. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
